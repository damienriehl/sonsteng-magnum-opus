site/__pycache__/
tools/__pycache__/
*.pyc

# Throwaway build artifacts regenerated by the generators + bundled by the Worker
# at build time (editor map + server-only instructor bundle). Never committed.
build/
# Persona UAT run files and screenshots (covered by build/, named explicitly).
build/uat/
# Host-local apply-engine flock (runtime state; DO lease is the true cross-host mutex)
.locks/
# Repo-local isolated worktrees are live checkouts, not project inputs.
.worktrees/
.DS_Store
node_modules/
.wrangler/
.dev.vars
.dev.vars.*
