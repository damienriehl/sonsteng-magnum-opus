{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sonsteng.damienriehl.com/spine/schemas/firm.schema.json",
  "title": "Firm",
  "description": "The firm-level canon (authored BEFORE the matter fleet). Identity, timekeepers, rate card, clients, book of business, AR aging, realization/collection targets, and budget. Matter money data reconciles against this (WARN-level aggregate check).",
  "version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schema_version",
    "@id",
    "identity",
    "timekeepers",
    "rate_card",
    "clients",
    "book_of_business",
    "closed_matters",
    "ar_aging",
    "realization_target",
    "collection_target",
    "budget",
    "as_of_date"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^FIRM$" },
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "@id": { "type": "string" },
    "@context": { "type": ["string", "object"] },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "address": { "type": "string" },
        "contact": { "type": "string" },
        "letterhead_note": { "type": "string" }
      }
    },
    "timekeepers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "role", "rate"],
        "properties": {
          "id": { "type": "string", "pattern": "^FIRM-TK-\\d{2}$" },
          "name": { "type": "string" },
          "role": { "type": "string", "description": "e.g. 'partner', 'associate', 'paralegal'." },
          "rate": { "type": "number", "minimum": 0 }
        }
      }
    },
    "rate_card": {
      "type": "array",
      "minItems": 1,
      "description": "Standard rates by role; time-entry rates must match this or a declared matter engagement rate.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "rate"],
        "properties": {
          "role": { "type": "string" },
          "rate": { "type": "number", "minimum": 0 }
        }
      }
    },
    "clients": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "pattern": "^FIRM-C-\\d{2}$" },
          "name": { "type": "string" }
        }
      }
    },
    "book_of_business": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["matter_id", "client_id", "fee_type", "status"],
        "properties": {
          "matter_id": { "type": "string", "pattern": "^m\\d{2}$" },
          "client_id": { "type": "string", "pattern": "^FIRM-C-\\d{2}$" },
          "fee_type": { "type": "string", "enum": ["hourly", "contingency", "flat", "retainer"] },
          "status": { "type": "string", "enum": ["active", "closed", "prospective"] }
        }
      }
    },
    "closed_matters": {
      "type": "array",
      "description": "Historical closed-matter book (may reference matters outside m01..m20).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["matter_id", "client_id", "fee_type"],
        "properties": {
          "matter_id": { "type": "string", "pattern": "^m\\d{2}$" },
          "client_id": { "type": "string", "pattern": "^FIRM-C-\\d{2}$" },
          "fee_type": { "type": "string", "enum": ["hourly", "contingency", "flat", "retainer"] },
          "closed_date": { "type": "string", "format": "date" },
          "total_billed": { "type": "number", "minimum": 0 }
        }
      }
    },
    "ar_aging": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current", "days_1_30", "days_31_60", "days_61_90", "days_over_90"],
      "description": "Accounts-receivable aging buckets (USD).",
      "properties": {
        "current": { "type": "number", "minimum": 0 },
        "days_1_30": { "type": "number", "minimum": 0 },
        "days_31_60": { "type": "number", "minimum": 0 },
        "days_61_90": { "type": "number", "minimum": 0 },
        "days_over_90": { "type": "number", "minimum": 0 }
      }
    },
    "realization_target": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Target realization rate (0-1)."
    },
    "collection_target": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Target collection rate (0-1)."
    },
    "budget": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "budget", "actual", "variance_is_good"],
        "properties": {
          "id": { "type": "string", "pattern": "^FIRM-B-\\d{2}$" },
          "name": { "type": "string" },
          "budget": { "type": "number" },
          "actual": { "type": "number" },
          "variance_is_good": {
            "type": "boolean",
            "description": "true when actual under budget is favorable (an expense line); false for revenue lines where over is favorable."
          }
        }
      }
    },
    "as_of_date": { "type": "string", "format": "date" }
  }
}
