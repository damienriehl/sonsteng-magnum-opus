{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sonsteng.damienriehl.com/spine/schemas/persona.schema.json",
  "title": "Persona",
  "description": "An interviewable person in a matter, with a five-tier disclosure model, machine-checkable rapport triggers (closed enum), Rule 4.2 teaching-moment config, and a case-file knowledge boundary.",
  "version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "fact_ref": {
      "type": "string",
      "pattern": "^m\\d{2}\\.fact\\.\\d{3}$"
    },
    "role_ref": {
      "type": "string",
      "pattern": "^m\\d{2}\\.role\\.[a-z0-9-]+$"
    },
    "trigger": {
      "type": "string",
      "description": "CLOSED rapport-trigger vocabulary. Any token outside this enum is a validator ERROR.",
      "enum": [
        "open_ended_invitation",
        "wellbeing_question",
        "acknowledged_emotion",
        "no_interruption_streak",
        "confidentiality_reassurance",
        "nonjudgmental_response",
        "follow_up_on_hint",
        "explained_process"
      ]
    },
    "fact_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_ref", "text"],
      "properties": {
        "fact_ref": { "$ref": "#/$defs/fact_ref" },
        "text": {
          "type": "string",
          "description": "Verbatim disclosure content, anchored to facts.md via fact_ref."
        }
      }
    },
    "rapport_fact_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_ref", "text"],
      "anyOf": [
        { "required": ["min_turns"] },
        { "required": ["requires"] }
      ],
      "description": "A rapport-gated fact. Must carry min_turns and/or a non-empty requires[] of closed triggers.",
      "properties": {
        "fact_ref": { "$ref": "#/$defs/fact_ref" },
        "text": { "type": "string" },
        "min_turns": {
          "type": "integer",
          "minimum": 1,
          "description": "Minimum interview turns before this fact can surface."
        },
        "requires": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/trigger" }
        }
      }
    }
  },
  "required": [
    "id",
    "schema_version",
    "@id",
    "matter_id",
    "identity",
    "background",
    "personality",
    "emotional_state",
    "communication_style",
    "objectives_fears",
    "disposition",
    "interviewable_by",
    "represented_by_counsel",
    "rule_4_2",
    "disclosure",
    "knowledge_boundary"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^m\\d{2}\\.per\\.[a-z0-9-]+$" },
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "@id": { "type": "string" },
    "@context": { "type": ["string", "object"] },
    "matter_id": { "type": "string", "pattern": "^m\\d{2}$" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role"],
      "properties": {
        "name": { "type": "string" },
        "age": { "type": "integer", "minimum": 0 },
        "role": {
          "type": "string",
          "description": "Substantive role in the matter, e.g. 'client', 'defendant employee'."
        },
        "occupation": { "type": "string" },
        "pronouns": { "type": "string" }
      }
    },
    "background": { "type": "string" },
    "personality": { "type": "string" },
    "emotional_state": { "type": "string" },
    "communication_style": { "type": "string" },
    "objectives_fears": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objectives", "fears"],
      "properties": {
        "objectives": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "fears": { "type": "array", "items": { "type": "string" } }
      }
    },
    "disposition": {
      "type": "string",
      "enum": ["cooperative", "guarded", "over_talker", "distressed"]
    },
    "interviewable_by": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/role_ref" },
      "description": "Sides (by role id) permitted to interview this persona; each must exist in matter.sides."
    },
    "represented_by_counsel": {
      "type": "boolean",
      "description": "If true, interviewing this persona from an opposing role triggers the Rule 4.2 teaching moment."
    },
    "rule_4_2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applies"],
      "description": "Rule 4.2 (no-contact) teaching-moment configuration.",
      "properties": {
        "applies": {
          "type": "boolean",
          "description": "Whether a Rule 4.2 teaching moment fires for opposing-side interviewers."
        },
        "counsel_name": { "type": "string" },
        "teaching_moment": {
          "type": "string",
          "description": "In-app professional-responsibility teaching text shown/logged (not a silent block)."
        }
      }
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "volunteered",
        "revealed_if_asked",
        "rapport_gated",
        "concealed",
        "unknown"
      ],
      "description": "The five disclosure tiers. Every item anchors to facts.md via fact_ref.",
      "properties": {
        "volunteered": { "type": "array", "items": { "$ref": "#/$defs/fact_item" } },
        "revealed_if_asked": { "type": "array", "items": { "$ref": "#/$defs/fact_item" } },
        "rapport_gated": { "type": "array", "items": { "$ref": "#/$defs/rapport_fact_item" } },
        "concealed": { "type": "array", "items": { "$ref": "#/$defs/fact_item" } },
        "unknown": { "type": "array", "items": { "$ref": "#/$defs/fact_item" } }
      }
    },
    "knowledge_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pinned_to_case_file", "unknown_response_style", "color_topics"],
      "description": "Fact-fidelity pinning. color_topics MUST be disjoint from material facts (validator ERROR on overlap).",
      "properties": {
        "pinned_to_case_file": {
          "const": true,
          "description": "All material facts are pinned to the case file; no free improvisation of case facts."
        },
        "unknown_response_style": {
          "type": "string",
          "description": "In-character deflection style for case-relevant unknowns, e.g. \"I don't remember / I'm not sure.\""
        },
        "color_topics": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Non-material flavor topics the persona may improvise on (weather, hobbies). Never material facts."
        }
      }
    }
  }
}
