{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sonsteng.damienriehl.com/spine/schemas/day-zero-holdouts.schema.json",
  "title": "Reviewed fixed-fact date holdouts",
  "version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "description", "method", "summary", "entries"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "description": { "type": "string" },
    "method": { "type": "string" },
    "summary": { "type": "object", "required": ["count", "by_reason"] },
    "entries": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["source", "locator", "literal", "reason", "review_status"], "properties": { "source": {"type":"string"}, "locator": {"type":"string"}, "literal": {"type":"string"}, "reason": {"type":"string"}, "review_status": {"const":"candidate_pending_human_review"} } } }
  }
}
