{
  // Sonsteng client-interview / debrief / critique Worker.
  // Zero-build, plain-JS ES modules + native JSON import (wrangler bundles both).
  // Secrets are set out-of-band and NEVER live here: SESSION_SIGNING_KEY,
  // DEMO_BYPASS_TOKEN, and OPTIONALLY ANTHROPIC_API_KEY (wrangler secret put).
  // Provider-agnostic BYOK: users may bring their own anthropic/openai/google
  // key per request; if ANTHROPIC_API_KEY is unset the hosted demo pool is
  // dormant and non-BYOK requests get the typed no_hosted_key error.
  "name": "sonsteng-chat",
  "main": "src/index.js",
  "compatibility_date": "2026-07-17",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "logs": { "head_sampling_rate": 1 } },

  // The generator-emitted editor map + server-only instructor bundle are copied
  // into src's import tree (editor-data/) before wrangler bundles. Regenerate the
  // sources first: `python3 tools/build_site.py --check && python3 tools/build_instructor_bundle.py`.
  "build": {
    "command": "node scripts/bundle-editor-data.mjs"
  },

  "durable_objects": {
    "bindings": [
      { "name": "BUDGET", "class_name": "BudgetCounter" },
      { "name": "EDITOR", "class_name": "EditorStore" }
    ]
  },
  // Migrations are APPEND-ONLY: v1 (BudgetCounter) is never altered; v2 adds the
  // EditorStore SQLite class for the editor experience.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BudgetCounter"] },
    { "tag": "v2", "new_sqlite_classes": ["EditorStore"] }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://sonsteng-dev.damienriehl.com,https://sonsteng.damienriehl.com",
    "MODEL_DEFAULT_ANTHROPIC": "claude-haiku-4-5",
    "MODEL_DEFAULT_OPENAI": "gpt-4o-mini",
    "MODEL_DEFAULT_GOOGLE": "gemini-2.0-flash",
    "MODEL_ALLOW_ANTHROPIC": "claude-haiku-4-5,claude-haiku-4-5-20251001,claude-sonnet-4-5",
    "MODEL_ALLOW_OPENAI": "gpt-4o-mini,gpt-4o",
    "MODEL_ALLOW_GOOGLE": "gemini-2.0-flash,gemini-2.5-flash",
    "PUBLIC_BUDGET_USD": "7",
    "DEMO_RESERVE_USD": "3",
    "MAX_TURNS": "20",
    "MAX_SESSIONS_PER_DAY": "200",

    // ---- Editor experience -------------------------------------------------
    // EDIT_UPSTREAM: the DEV static origin the proxy-injector fetches (prefix +
    // trailing slash). Every allowlisted page key resolves under it.
    "EDIT_UPSTREAM": "https://sonsteng-dev.damienriehl.com/platform/",
    // EDIT_ORIGIN: the worker's OWN edit origin — the SOLE /edit CORS allowlist.
    "EDIT_ORIGIN": "https://sonsteng-chat.damienriehl.workers.dev",
    // Scope grants per token slot (independent per-scope version for rotation).
    // The opaque token values are SECRETS: EDIT_TOKEN_JOHN, EDIT_TOKEN_ADMIN
    // (set with `wrangler secret put`, never here). admin is reachable ONLY via
    // the admin token — never from edit/instructor tokens.
    "EDIT_TOKEN_SCOPES": "{\"john\":{\"edit\":1,\"instructor\":1},\"admin\":{\"admin\":1}}",
    // Suggestion ceilings (see docs/research/editor-apply-spec.md §Ceilings).
    "EDIT_MAX_PENDING_PER_EDITOR": "200",
    "EDIT_MAX_DAILY_PER_EDITOR": "500",
    "EDIT_MAX_BYTES": "16384"
  }
}
