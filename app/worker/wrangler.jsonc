{
  // Sonsteng client-interview / debrief / critique Worker.
  // Zero-build, plain-JS ES modules + native JSON import (wrangler bundles both).
  // Secrets are set out-of-band and NEVER live here: SESSION_SIGNING_KEY,
  // DEMO_BYPASS_TOKEN, and OPTIONALLY ANTHROPIC_API_KEY (wrangler secret put).
  // Provider-agnostic BYOK: users may bring their own anthropic/openai/google
  // key per request; if ANTHROPIC_API_KEY is unset the hosted demo pool is
  // dormant and non-BYOK requests get the typed no_hosted_key error.
  //
  // ENVIRONMENTS (Editor experience — PROD injector wiring, WP1):
  //   * TOP-LEVEL (this default block) = DEV. A bare `wrangler deploy` (no --env)
  //     deploys the DEV worker `sonsteng-chat` exactly as it has always worked —
  //     EDIT_UPSTREAM points at the DEV static origin. DO NOT CHANGE THIS if you
  //     only mean to touch PROD.
  //   * env.dev = an explicit mirror of the top-level DEV config (so
  //     `wrangler deploy --env dev` is equivalent to the default deploy).
  //   * env.production = the held PROD injector. Deployed ONLY by the documented
  //     one-command enable in docs/prod-enable.md — never as part of routine work.
  //     Its EDIT_UPSTREAM points at the PROD CF Pages origin.
  // Wrangler inheritance note: `vars` and `durable_objects` are NON-inheritable,
  // so each named environment RE-DECLARES them in full. `main`, `build`,
  // `migrations`, `observability`, and the compatibility keys ARE inherited from
  // the top level, so they are declared once here.
  "name": "sonsteng-chat",
  "main": "src/index.js",
  "compatibility_date": "2026-07-17",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "logs": { "head_sampling_rate": 1 } },

  // ⚠ REQUIRED, DO NOT REMOVE. Wrangler defaults `workers_dev` to FALSE as soon
  // as any `routes` key is present, and it says so only in an advisory warning
  // during deploy. Adding the Access-door route below therefore SILENTLY
  // unbound sonsteng-chat.damienriehl.workers.dev — John's and Roger's fallback
  // door — which returned a bare Cloudflare "error code: 1042" instead of the
  // editor. That is precisely the R4 breakage this plan exists to prevent, and
  // it was caused by the plan's own U1. Both doors stay open only while this is
  // explicitly true. Inheritable, so it covers env.dev and env.production too
  // (env.production now declares `routes: []`, which is enough to trip the same
  // default).
  "workers_dev": true,

  // ---- Access door custom domain (plan U1) ---------------------------------
  // `custom_domain: true` makes Cloudflare provision the DNS record and the
  // certificate for this hostname on the next deploy of the DEFAULT env. The
  // workers.dev origin keeps serving unchanged — this route is ADDITIVE, which
  // is what lets both doors stay open through KD1's staged retirement.
  //
  // ⚠ `routes` is an INHERITABLE key, and env.production declares its own empty
  // list precisely so this one cannot follow `--env production` and try to bind
  // the DEV hostname to sonsteng-chat-production. Do not remove that empty list.
  "routes": [
    { "pattern": "edit.legalpracticum.org", "custom_domain": true },
    { "pattern": "edit.sonsteng.damienriehl.com", "custom_domain": true },
    { "pattern": "www.legalpracticum.org", "custom_domain": true },
    { "pattern": "sonsteng.damienriehl.com", "custom_domain": true }
  ],

  // The generator-emitted editor map + server-only instructor bundle are copied
  // into src's import tree (editor-data/) before wrangler bundles. Regenerate the
  // sources first: `python3 tools/build_site.py --check && python3 tools/build_instructor_bundle.py`.
  "build": {
    "command": "node scripts/bundle-editor-data.mjs"
  },

  "durable_objects": {
    "bindings": [
      { "name": "BUDGET", "class_name": "BudgetCounter" },
      { "name": "EDITOR", "class_name": "EditorStore" }
    ]
  },
  // Migrations are APPEND-ONLY: v1 (BudgetCounter) is never altered; v2 adds the
  // EditorStore SQLite class for the editor experience. Inherited by every env.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BudgetCounter"] },
    { "tag": "v2", "new_sqlite_classes": ["EditorStore"] }
  ],

  // ---- TOP-LEVEL vars = DEV defaults (the default `wrangler deploy` target) ----
  "vars": {
    "ALLOWED_ORIGINS": "https://sonsteng-dev.damienriehl.com,https://legalpracticum.org",
    "MODEL_DEFAULT_ANTHROPIC": "claude-haiku-4-5",
    "MODEL_DEFAULT_OPENAI": "gpt-4o-mini",
    "MODEL_DEFAULT_GOOGLE": "gemini-2.0-flash",
    "MODEL_ALLOW_ANTHROPIC": "claude-haiku-4-5,claude-haiku-4-5-20251001,claude-sonnet-4-5",
    "MODEL_ALLOW_OPENAI": "gpt-4o-mini,gpt-4o",
    "MODEL_ALLOW_GOOGLE": "gemini-2.0-flash,gemini-2.5-flash",
    "PUBLIC_BUDGET_USD": "7",
    "DEMO_RESERVE_USD": "3",
    "MAX_TURNS": "20",
    "MAX_SESSIONS_PER_DAY": "200",
    "MAX_ASSESSMENTS_PER_SESSION_DAY": "20",

    // STREAMING: SSE token streaming for POST /v1/chat (docs/research/
    // worker-llm-facts.md §4). "false" = the DEFAULT non-streaming path (one
    // JSON response; client shows a typing indicator). "true" proxies the
    // provider's SSE through a TransformStream, capturing each provider's
    // terminal usage so budget/replay bookkeeping stays identical. Supported
    // for Anthropic, OpenAI, and Google BYOK. Enabled on DEV for U19 validation;
    // production remains explicitly OFF.
    "STREAMING": "true",

    // ---- Turnstile bot-gate (WP6) ------------------------------------------
    // TURNSTILE_ENABLED: "false" disables the GET /v1/session bot-gate
    // deployment-wide; ANY other value (incl. unset) = ENABLED (fail-closed).
    // TURNSTILE_SITEKEY is PUBLIC (rendered in the client) — kept here for env
    // parity/visibility; the frontend actually reads it from the page's
    // <meta name="turnstile-sitekey"> (static site can't read wrangler vars).
    // The verification SECRET is `wrangler secret put TURNSTILE_SECRET` (never
    // here). Demo-bypass requests skip the gate entirely (keyless flows).
    // One widget covers DEV + PROD hostnames, so the sitekey is the same in
    // every env. PROD needs its own TURNSTILE_SECRET set at enable time
    // (docs/prod-enable.md).
    "TURNSTILE_ENABLED": "true",
    "TURNSTILE_SITEKEY": "0x4AAAAAAD4uPMN8eNwzYvAy",

    // ---- Editor experience -------------------------------------------------
    // EDIT_UPSTREAM: the DEV static origin the proxy-injector fetches (prefix +
    // trailing slash). Every allowlisted page key resolves under it.
    "EDIT_UPSTREAM": "https://sonsteng-dev.damienriehl.com/platform/",
    // EDIT_ORIGIN: the worker's OWN edit origins — the SOLE /edit allowlist, and
    // a COMMA-SEPARATED LIST, not a single value (plan KTD6). It is enforced
    // twice in editor-http.js: editCorsHeaders withholds CORS from a non-matching
    // Origin, and csrfOk REJECTS any request whose Origin is not on the list. One
    // env now serves two browser origins — the Access hostname and the workers.dev
    // fallback the ?t= bookmarks still use — so a single value cannot cover both:
    // swapping it would leave every existing bookmark loading pages normally while
    // every save returned 403 csrf_failed. Drop the workers.dev entry only when
    // the last ?t= token retires (plan KD1).
    "EDIT_ORIGIN": "https://edit.legalpracticum.org,https://sonsteng-chat.damienriehl.workers.dev",

    // ---- Cloudflare Access door (plan KTD8) --------------------------------
    // The three verification inputs, declared as config and NEVER derived from
    // the token. EDIT_ACCESS_TEAM_DOMAIN in particular must come from here and
    // never from the assertion's own `iss`, or an attacker-supplied token would
    // nominate its own signing keys. access-jwt.js returns null when ANY of the
    // three is empty, so an env without them fails CLOSED — which is exactly how
    // env.production stays safe under R7 while carrying none of them.
    //
    // EDIT_ACCESS_AUD is the Access application's Application Audience tag,
    // captured during the U10 domain cutover on 2026-08-23 (app id
    // d64fe7d0-ee8b-4670-a6e1-5676d7b3815d, "Legal Practicum Editor"). It is not a secret — it rides in every
    // assertion — but it IS load-bearing: access-jwt.js checks the token's `aud`
    // against it, so a wrong value fails every sign-in closed. Emptying it turns
    // the Access door off and leaves only the ?t= door, which is the safe state.
    "EDIT_ACCESS_AUD": "b0acc1e2841eacbd9d5d99090a33ff2b558bd0ca2241310762309bc77778fc21",
    "EDIT_ACCESS_TEAM_DOMAIN": "young-unit-68fd.cloudflareaccess.com",
    "EDIT_ACCESS_HOST": "edit.legalpracticum.org",
    "EDIT_LEGACY_HOST": "edit.sonsteng.damienriehl.com",
    // Canonical public host and exact aliases served only as permanent redirects.
    "PUBLIC_CANONICAL_HOST": "legalpracticum.org",
    "PUBLIC_REDIRECT_HOSTS": "www.legalpracticum.org,sonsteng.damienriehl.com",

    // Scope grants per token slot (independent per-scope version for rotation).
    // The opaque token values are SECRETS: EDIT_TOKEN_JOHN, EDIT_TOKEN_ROGER,
    // EDIT_TOKEN_ADMIN (set with `wrangler secret put`, never here). admin is
    // reachable ONLY via the admin token — never from edit/instructor tokens.
    // john -> "JOS", roger -> "RSH" attribution labels (see editor-auth.js).
    //
    // `damienadmin` is the ONE slot carrying edit+instructor+admin together, and
    // it deliberately has NO EDIT_TOKEN_DAMIENADMIN secret — it is reachable only
    // through Access. That is what lets one Access identity hold admin scope AND
    // DR attribution without widening the token path: the invariant in
    // editor-auth.js ("admin is NEVER reachable from an edit/instructor token,
    // separate secret, separate record") stays literally true for ?t= tokens.
    "EDIT_TOKEN_SCOPES": "{\"john\":{\"edit\":1,\"instructor\":1},\"roger\":{\"edit\":1,\"instructor\":1},\"damien\":{\"edit\":1,\"instructor\":1},\"damienadmin\":{\"edit\":1,\"instructor\":1,\"admin\":1,\"publisher\":1},\"admin\":{\"admin\":1},\"release\":{\"release_service\":1}}",
    "PROD_RELEASE_LEDGER": "true",
    // Suggestion ceilings (see docs/research/editor-apply-spec.md §Ceilings).
    "EDIT_MAX_PENDING_PER_EDITOR": "200",
    "EDIT_MAX_DAILY_PER_EDITOR": "500",
    "EDIT_MAX_BYTES": "16384",

    // DIRECT_APPLY (canonical direct-apply mode): "true" makes a human EDIT
    // suggestion auto-accept at suggest-time (the home-box apply daemon then
    // claims + applies it) — comments and system origins are unaffected. "false"
    // (or unset) = classic suggestion mode (Damien reviews each edit via decide).
    // The client never clears optimistically; status always flows from the store.
    "DIRECT_APPLY": "true"
  },

  "env": {
    // ---- DEV (explicit mirror of the top-level default) --------------------
    // `wrangler deploy --env dev` == the default deploy. Kept in sync with the
    // top-level vars block above.
    "dev": {
      "name": "sonsteng-chat",
      "durable_objects": {
        "bindings": [
          { "name": "BUDGET", "class_name": "BudgetCounter" },
          { "name": "EDITOR", "class_name": "EditorStore" }
        ]
      },
      "vars": {
        "ALLOWED_ORIGINS": "https://sonsteng-dev.damienriehl.com,https://legalpracticum.org",
        "MODEL_DEFAULT_ANTHROPIC": "claude-haiku-4-5",
        "MODEL_DEFAULT_OPENAI": "gpt-4o-mini",
        "MODEL_DEFAULT_GOOGLE": "gemini-2.0-flash",
        "MODEL_ALLOW_ANTHROPIC": "claude-haiku-4-5,claude-haiku-4-5-20251001,claude-sonnet-4-5",
        "MODEL_ALLOW_OPENAI": "gpt-4o-mini,gpt-4o",
        "MODEL_ALLOW_GOOGLE": "gemini-2.0-flash,gemini-2.5-flash",
        "PUBLIC_BUDGET_USD": "7",
        "DEMO_RESERVE_USD": "3",
        "MAX_TURNS": "20",
        "MAX_SESSIONS_PER_DAY": "200",
        "MAX_ASSESSMENTS_PER_SESSION_DAY": "20",
        "STREAMING": "true",
        "TURNSTILE_ENABLED": "true",
        "TURNSTILE_SITEKEY": "0x4AAAAAAD4uPMN8eNwzYvAy",
        "EDIT_UPSTREAM": "https://sonsteng-dev.damienriehl.com/platform/",
        // Mirrors the top-level list (KTD6). vars are NON-INHERITABLE, so this
        // block must repeat every value — setting only the top-level one would
        // leave `--env dev` serving the old single origin.
        "EDIT_ORIGIN": "https://edit.legalpracticum.org,https://sonsteng-chat.damienriehl.workers.dev",
        "EDIT_ACCESS_AUD": "b0acc1e2841eacbd9d5d99090a33ff2b558bd0ca2241310762309bc77778fc21",
        "EDIT_ACCESS_TEAM_DOMAIN": "young-unit-68fd.cloudflareaccess.com",
        "EDIT_ACCESS_HOST": "edit.legalpracticum.org",
        "EDIT_LEGACY_HOST": "edit.sonsteng.damienriehl.com",
        "PUBLIC_CANONICAL_HOST": "legalpracticum.org",
        "PUBLIC_REDIRECT_HOSTS": "www.legalpracticum.org,sonsteng.damienriehl.com",
        "EDIT_TOKEN_SCOPES": "{\"john\":{\"edit\":1,\"instructor\":1},\"roger\":{\"edit\":1,\"instructor\":1},\"damien\":{\"edit\":1,\"instructor\":1},\"damienadmin\":{\"edit\":1,\"instructor\":1,\"admin\":1,\"publisher\":1},\"admin\":{\"admin\":1},\"release\":{\"release_service\":1}}",
        "PROD_RELEASE_LEDGER": "true",
        "EDIT_MAX_PENDING_PER_EDITOR": "200",
        "EDIT_MAX_DAILY_PER_EDITOR": "500",
        "EDIT_MAX_BYTES": "16384",
        "DIRECT_APPLY": "true"
      }
    },

    // ---- PRODUCTION (HELD — enable only via docs/prod-enable.md) -----------
    // A SEPARATE worker instance (`sonsteng-chat-production`) so DEV keeps
    // working untouched while PROD is enabled. The ONLY per-env deltas from DEV
    // are EDIT_UPSTREAM (-> PROD CF Pages origin) and EDIT_ORIGIN (-> the PROD
    // worker's own origin).
    //
    // ⚠ DAMIEN DECISION — EDIT_ORIGIN below assumes the PROD worker is reachable
    // at its default workers.dev subdomain (sonsteng-chat-production.
    // damienriehl.workers.dev). If PROD instead mounts the worker on a custom
    // route/subdomain (e.g. edit.legalpracticum.org or a route on
    // legalpracticum.org), set EDIT_ORIGIN to THAT origin and add a
    // `routes` block here. EDIT_ORIGIN is the sole /edit CORS allowlist, so it
    // MUST equal the browser origin the editor is actually served from.
    "production": {
      "name": "sonsteng-chat-production",
      // ⚠ DELIBERATELY EMPTY — do not delete. `routes` is inheritable, so without
      // the top-level Access-door custom domains would follow `wrangler deploy
      // --env production` and try to bind the
      // DEV hostname to this PROD worker — failing the deploy, or stealing the
      // hostname from DEV. R7 ("PROD is untouched") is true of the file text
      // without this line and FALSE of the effective config. Verify with
      // `npx wrangler@4 deploy --env production --dry-run`, which must report no
      // route for the Access hostname.
      "routes": [],
      "durable_objects": {
        "bindings": [
          { "name": "BUDGET", "class_name": "BudgetCounter" },
          { "name": "EDITOR", "class_name": "EditorStore" }
        ]
      },
      "vars": {
        "ALLOWED_ORIGINS": "https://sonsteng-dev.damienriehl.com,https://legalpracticum.org",
        "MODEL_DEFAULT_ANTHROPIC": "claude-haiku-4-5",
        "MODEL_DEFAULT_OPENAI": "gpt-4o-mini",
        "MODEL_DEFAULT_GOOGLE": "gemini-2.0-flash",
        "MODEL_ALLOW_ANTHROPIC": "claude-haiku-4-5,claude-haiku-4-5-20251001,claude-sonnet-4-5",
        "MODEL_ALLOW_OPENAI": "gpt-4o-mini,gpt-4o",
        "MODEL_ALLOW_GOOGLE": "gemini-2.0-flash,gemini-2.5-flash",
        "PUBLIC_BUDGET_USD": "7",
        "DEMO_RESERVE_USD": "3",
        "MAX_TURNS": "20",
        "MAX_SESSIONS_PER_DAY": "200",
        "MAX_ASSESSMENTS_PER_SESSION_DAY": "20",
        "STREAMING": "false",
        // Bot-gate ON in PROD too; the widget's domain list covers
        // legalpracticum.org, so no new widget at enable time — but PROD
        // needs its OWN `wrangler secret put TURNSTILE_SECRET --env production`
        // (docs/prod-enable.md). Same public sitekey as DEV (one widget).
        "TURNSTILE_ENABLED": "true",
        "TURNSTILE_SITEKEY": "0x4AAAAAAD4uPMN8eNwzYvAy",
        // PROD static is served by Cloudflare Pages at legalpracticum.org.
        "EDIT_UPSTREAM": "https://legalpracticum.org/platform/",
        // The PROD worker's OWN edit origin (see ⚠ DAMIEN DECISION above).
        "EDIT_ORIGIN": "https://sonsteng-chat-production.damienriehl.workers.dev",
        "EDIT_TOKEN_SCOPES": "{\"john\":{\"edit\":1,\"instructor\":1},\"roger\":{\"edit\":1,\"instructor\":1},\"damien\":{\"edit\":1,\"instructor\":1},\"admin\":{\"admin\":1}}",
        "PROD_RELEASE_LEDGER": "false",
        "EDIT_MAX_PENDING_PER_EDITOR": "200",
        "EDIT_MAX_DAILY_PER_EDITOR": "500",
        "EDIT_MAX_BYTES": "16384",
        // Production editing never auto-accepts. Approval/DEV application and
        // human Publisher authorization are deliberately separate lifecycles.
        "DIRECT_APPLY": "false"
      }
    }
  }
}
